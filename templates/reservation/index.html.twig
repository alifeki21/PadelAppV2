{% extends 'base.html.twig' %}

{% set active_page = 'reservation' %}

{% block title %}Réserver un terrain - Padel House{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/reservation.css') }}">
{% endblock %}

{% block body %}
    <main class="main-content">
        <div class="container">
            <div class="page-header">
                <h1>Réservez votre terrain de Padel</h1>
                <p>Réservez votre terrain en quelques clics</p>
            </div>

            <div class="progress-bar">
                <div class="progress-step active">
                    <span class="step-number">1</span>
                    <span class="step-label">Choix de court</span>
                </div>
                <div class="progress-line"></div>
                <div class="progress-step">
                    <span class="step-number">2</span>
                    <span class="step-label">Choix de crenaux</span>
                </div>
                <div class="progress-line"></div>
                <div class="progress-step">
                    <span class="step-number">3</span>
                    <span class="step-label">Détails</span>
                </div>
                <div class="progress-line"></div>
                <div class="progress-step">
                    <span class="step-number">4</span>
                    <span class="step-label">Confirmer</span>
                </div>
            </div>

            <div class="reservation-container">
                <section class="reservation-step" id="step1">
                    <h2><i class="fas fa-map-pin"></i> Select Your Court</h2>

                    <div class="court-grid">
                        {% for court in courts %}
                            <div class="court-card" data-court="{{ court.id }}">
                                <div class="court-image">
                                    <img src="{{ asset('images/' ~ (court.image ?: 'cupra.png')) }}" alt="{{ court.name }}">
                                    {% if loop.first %}
                                        <span class="court-status available">Available Today</span>
                                    {% endif %}
                                </div>
                                <div class="court-info">
                                    <h3>{{ court.name }}</h3>
                                    <div class="court-features">
                                        {% if court.isIndoor %}
                                            <span><i class="fas fa-house"></i> Indoor</span>
                                            <span><i class="fas fa-wind"></i> Wind-protected</span>
                                            <span><i class="fas fa-temperature-high"></i> Heated</span>
                                            <span><i class="fas fa-snowflake"></i> Air conditioned</span>
                                        {% else %}
                                            <span><i class="fas fa-cloud-sun"></i> Extérieur</span>
                                            <span><i class="fas fa-coffee"></i> Café à proximité</span>
                                            <span><i class="fas fa-sun"></i> Profitez du soleil</span>
                                        {% endif %}
                                    </div>
                                    <div class="court-price">
                                        <span class="price">{{ court.pricePerHour }} DT</span> <span class="period">/heure</span>
                                    </div>
                                    <button class="btn-select-court" type="button" data-id="{{ court.id }}">Select Court</button>
                                </div>
                            </div>
                        {% else %}
                            <p>Aucun terrain disponible pour le moment.</p>
                        {% endfor %}
                    </div>
                </section>

                <section class="reservation-step hidden" id="step2">
                    <h2><i class="fas fa-clock"></i> Choose Date & Time</h2>

                    <div class="datetime-container">
                        <div class="date-picker">
                            <label for="reservation-date">Sélectionnez la date</label>
                            <input type="date" id="reservation-date" min="2026-02-16" value="2026-02-16">
                        </div>

                        <div class="time-slots">
                            <label>Créneaux disponibles</label>
                            <div class="slot-grid" id="time-slots"></div>
                        </div>
                    </div>

                    <div class="step-navigation">
                        <button class="btn-secondary">Retour</button>
                        <button class="btn-primary">Continuer</button>
                    </div>
                </section>

                <section class="reservation-step hidden" id="step3">
                    <h2><i class="fas fa-users"></i> Détails de la réservation</h2>

                    <div class="details-form">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="player-count">Nombre de joueurs</label>
                                <select id="player-count">
                                    <option value="2">2 joueurs</option>
                                    <option value="3">3 joueurs</option>
                                    <option value="4" selected>4 joueurs</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="reservation-requirements">Demandes particulières</label>
                                <textarea id="reservation-requirements" rows="4" maxlength="500" placeholder="Raquettes, balles, préférence de terrain..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="step-navigation">
                        <button class="btn-secondary">Back</button>
                        <button class="btn-primary">Continue</button>
                    </div>
                </section>

                <section class="reservation-step hidden" id="step4">
                    <div class="booking-card">
                        <h2 class="step-title">Confirmez votre Réservation</h2>
                        <p class="step-subtitle">Vérifiez les détails de votre ticket de réservation avant de valider.</p>

                        <div class="reservation-ticket">
                            <div class="ticket-header">
                                <h3>Ticket de Réservation</h3>
                                <span class="ticket-badge">En attente</span>
                            </div>

                            <div class="ticket-body">
                                <div class="summary-item">
                                    <span class="summary-label"><i class="fas fa-table-tennis"></i> Terrain :</span>
                                    <span class="summary-value" id="summary-court">Non sélectionné</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label"><i class="far fa-calendar-alt"></i> Date :</span>
                                    <span class="summary-value" id="summary-date">Non sélectionné</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label"><i class="far fa-clock"></i> Créneau :</span>
                                    <span class="summary-value" id="summary-time">Non sélectionné</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label"><i class="fas fa-hourglass-half"></i> Durée :</span>
                                    <span class="summary-value">90 minutes (1h30)</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label"><i class="fas fa-users"></i> Joueurs :</span>
                                    <span class="summary-value" id="summary-players">4 joueurs</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label"><i class="fas fa-clipboard-list"></i> Demandes :</span>
                                    <span class="summary-value" id="summary-requirements">Aucune</span>
                                </div>

                                <hr class="ticket-divider">

                                <div class="summary-total">
                                    <span>Montant à payer :</span>
                                    <span id="summary-total">100.00 DT</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary">Retour</button>
                            <button type="button" class="btn btn-primary" id="btn-confirm-final">Confirmer et Réserver</button>
                        </div>
                    </div>
                </section>

                <div class="success-message hidden" id="successMessage">
                    <i class="fas fa-check-circle"></i>
                    <h3>Booking Confirmed!</h3>
                    <p>Your court has been successfully reserved.</p>
                    <a href="#" id="returnToStep1" class="btn-primary">Return</a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/reservation.js') }}"></script>
{% endblock %}
