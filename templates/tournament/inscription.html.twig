{% extends 'base.html.twig' %}

{% block title %}Inscription Tournois – Padel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/inscription_tournois.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
    <section class="tournois-section container mt-5">
        <h2 class="section-title">Inscription aux tournois</h2>
        
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-3">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mt-3">
                {{ message }}
            </div>
        {% endfor %}

        <div id="tournaments" class="tournoi-grid mt-4">
            {% for tournament in tournaments %}
                {% set currentTeams = tournament.tournamentRegistrations|length %}
                <div class="tournoi-card">
                    <h3 class="tournoi-title">{{ tournament.name }}</h3>
                    <p class="tournoi-date">📅 {{ tournament.startDate|date('d/m/Y') }}</p>
                    <p class="tournoi-spots">Équipes : {{ currentTeams }} / {{ tournament.maxTeams ?: '16' }}</p>
                    
                    {% if tournament.maxTeams is null or currentTeams < tournament.maxTeams %}
                        <a href="{{ path('app_tournaments_register', {'id': tournament.id}) }}" class="btn btn-primary register-btn">S'inscrire</a>
                    {% else %}
                        <button class="btn btn-secondary register-btn" disabled style="cursor: not-allowed;">Complet</button>
                    {% endif %}
                </div>
            {% else %}
                <p>Aucun tournoi disponible pour le moment.</p>

            {% endfor %}
        </div>
    </section>
{% endblock %}
