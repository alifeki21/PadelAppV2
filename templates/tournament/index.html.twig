{% extends 'base.html.twig' %}

{% set active_page = 'tournois' %}

{% block title %}Tournois - Padel Badeli 7yeti{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/tournois.css') }}">
{% endblock %}

{% block body %}
    <main class="tournois-container">
        <div class="tournois-header">
            <h1><i class="fas fa-trophy"></i> Tournois</h1>
            <p class="last-updated">Dernière mise à jour : 11 février 2026</p>
        </div>

        <section class="upcoming-tournaments">
            <h2><i class="fas fa-calendar-alt"></i> Prochains Tournois</h2>
            <div class="tournament-cards">
                {#
                  TODO: replace these three static cards with:
                  {% for t in tournaments %}
                      <div class="tournament-card"> ...
                  {% endfor %}
                #}
                <div class="tournament-card">
                    <div class="tournament-image">
                        <img src="{{ asset('images/tournois_hello.jpg') }}" alt="Tournoi Hello Padel">
                        <div class="tournament-date">
                            <span class="day">15</span>
                            <span class="month">MAR</span>
                        </div>
                    </div>
                    <div class="tournament-details">
                        <h3>Tournoi Hello Padel</h3>
                        <p><i class="fas fa-map-marker-alt"></i> Padel Badeli 7yeti</p>
                        <p><i class="fas fa-users"></i> 16 paires max</p>
                        <p><i class="fas fa-tag"></i> Niveau : P25/P50/P100</p>
                        <div class="tournament-footer">
                            <span class="prize"><i class="fas fa-medal"></i> Inscription : 60 DT</span>
                            {# TODO: href="{{ path('app_tournament_register', { id: t.id }) }}" #}
                            <a href="#" class="btn-register">S'inscrire</a>
                        </div>
                    </div>
                </div>

                <div class="tournament-card">
                    <div class="tournament-image">
                        <img src="{{ asset('images/hero.jpg') }}" alt="Tournoi Amical">
                        <div class="tournament-date">
                            <span class="day">22</span>
                            <span class="month">MAR</span>
                        </div>
                    </div>
                    <div class="tournament-details">
                        <h3>Tournoi Amical</h3>
                        <p><i class="fas fa-map-marker-alt"></i> Padel Badeli 7yeti</p>
                        <p><i class="fas fa-users"></i> 8 paires (2 WC)</p>
                        <p><i class="fas fa-tag"></i> Niveau : P1000/P1000 mixte</p>
                        <div class="tournament-footer">
                            <span class="prize"><i class="fas fa-medal"></i> Inscription : 60 DT</span>
                            <a href="#" class="btn-register">S'inscrire</a>
                        </div>
                    </div>
                </div>

                <div class="tournament-card">
                    <div class="tournament-image">
                        <img src="{{ asset('images/Dora-Chamli.jpg') }}" alt="Tournoi Féminin">
                        <div class="tournament-date">
                            <span class="day">05</span>
                            <span class="month">AVR</span>
                        </div>
                    </div>
                    <div class="tournament-details">
                        <h3>Tournoi Féminin</h3>
                        <p><i class="fas fa-map-marker-alt"></i> Padel Badeli 7yeti</p>
                        <p><i class="fas fa-users"></i> 16 paires max</p>
                        <p><i class="fas fa-tag"></i> Niveau : P25/50/100/1000</p>
                        <div class="tournament-footer">
                            <span class="prize"><i class="fas fa-medal"></i> Inscription : 60 DT</span>
                            <a href="#" class="btn-register">S'inscrire</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="brackets-section">
            <h2><i class="fas fa-diagram-project"></i> Tableaux des Tournois</h2>

            <div class="brackets-container">
                <div class="tournament-selector">
                    <label for="tournament-select">Sélectionner un tournoi :</label>
                    <select id="tournament-select" class="tournament-select">
                        <option>Tournoi Open Padel - 15 Mars 2026</option>
                        <option>Coupe des Ambassadeurs - 22 Mars 2026</option>
                        <option>Tournoi Féminin - 5 Avril 2026</option>
                        <option>Championnat Printemps - 12 Avril 2026</option>
                    </select>
                </div>

                <div class="round-carousel">
                    <button class="nav-arrow" id="prevRound" aria-label="Round précédent">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="round-viewport" id="roundViewport">
                        <div class="round-track" id="roundTrack">
                            <div class="round-card">
                                <h4><i class="fas fa-tasks"></i> Quarts de finale</h4>
                                <div class="matches-vertical">
                                    {% for pair in [['A', 'B'], ['C', 'D'], ['E', 'F'], ['G', 'H']] %}
                                        <div class="match-item">
                                            <div class="match-teams">
                                                <div class="team-row">
                                                    <span class="team-badge"></span>
                                                    <span class="team-name1">Équipe {{ pair[0] }}</span>
                                                </div>
                                                <div class="team-row">
                                                    <span class="team-badge team2-badge"></span>
                                                    <span class="team-name2">Équipe {{ pair[1] }}</span>
                                                </div>
                                            </div>
                                            <span class="match-score-badge">-</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="round-card">
                                <h4><i class="fas fa-chart-simple"></i> Demi-finales</h4>
                                <div class="matches-vertical">
                                    {% for pair in [[1, 2], [3, 4]] %}
                                        <div class="match-item">
                                            <div class="match-teams">
                                                <div class="team-row">
                                                    <span class="team-badge"></span>
                                                    <span class="team-name1">Vainqueur Quart {{ pair[0] }}</span>
                                                </div>
                                                <div class="team-row">
                                                    <span class="team-badge team2-badge"></span>
                                                    <span class="team-name2">Vainqueur Quart {{ pair[1] }}</span>
                                                </div>
                                            </div>
                                            <span class="match-score-badge">-</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="round-card">
                                <h4><i class="fas fa-crown"></i> Finale</h4>
                                <div class="matches-vertical">
                                    <div class="match-item final">
                                        <div class="match-teams">
                                            <div class="team-row">
                                                <span class="team-badge"></span>
                                                <span class="team-name1">Vainqueur Demi 1</span>
                                            </div>
                                            <div class="team-row">
                                                <span class="team-badge team2-badge"></span>
                                                <span class="team-name2">Vainqueur Demi 2</span>
                                            </div>
                                        </div>
                                        <span class="match-score-badge">-</span>
                                    </div>
                                </div>
                                <div class="champion-spot">
                                    <i class="fas fa-trophy"></i> Champion
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="nav-arrow" id="nextRound" aria-label="Tour suivant">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

                <div class="carousel-dots" id="carouselDots">
                    <button class="dot active" data-index="0" aria-label="Aller aux quarts de finale"></button>
                    <button class="dot" data-index="1" aria-label="Aller aux demi-finales"></button>
                    <button class="dot" data-index="2" aria-label="Aller à la finale"></button>
                </div>
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/tournois.js') }}"></script>
{% endblock %}
