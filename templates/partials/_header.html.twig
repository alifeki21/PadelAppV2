{# Active nav item: pass `active_page` from each page template (e.g. 'home', 'reservation', 'tournois', 'contact', 'login', 'signup') #}
{% set active = active_page|default('') %}

<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <img src="{{ asset('images/padel house.png') }}" alt="Padel House">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link{% if active == 'home' %} active{% endif %}" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if active == 'reservation' %} active{% endif %}" href="{{ path('app_reservation') }}">Réservation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if active == 'tournois' %} active{% endif %}" href="{{ path('app_tournaments_index') }}">Tournois</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{% if active == 'contact' %} active{% endif %}" href="{{ path('app_contact') }}">Contact</a>
                    </li>

                    {# Show logout button if logged in, otherwise show Login / Sign-up links #}
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                👋 {{ app.user.firstName }} {{ app.user.lastName }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li class="dropdown-header">
                                    <span>Connecté en tant que</span>
                                    <strong>{{ app.user.email }}</strong>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_profile') }}">
                                        <i class="fas fa-user me-2 text-primary"></i> Mon Profil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_profile_reservations') }}">
                                        <i class="fas fa-calendar-check me-2 text-primary"></i> Mes Réservations
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                                    </a>
                                </li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link{% if active == 'login' %} active{% endif %}" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link{% if active == 'signup' %} active{% endif %}" href="{{ path('app_signup') }}">S'inscrire</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>
