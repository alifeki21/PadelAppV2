{% extends 'base.html.twig' %}

{% set active_page = 'signup' %}

{% block title %}Sign Up - Padel Badeli 7yeti{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/sign_up.css') }}">
{% endblock %}

{% block body %}
    <section class="on">
        <div class="signup-container">
            <div class="signup-form-container">
                {{ form_start(registrationForm, {
                    'attr': {'class': 'signup-form', 'id': 'signupForm', 'novalidate': 'novalidate'}
                }) }}

                    <div class="form-header">
                        <div class="logo">
                            <i class="fas fa-table-tennis"></i>
                            <h1>Padel Badeli 7yeti</h1>
                        </div>
                        <h2>Créez votre compte</h2>
                        <p>Rejoignez notre communauté pour réserver des terrains et vous connecter avec d'autres joueurs.</p>
                    </div>

                    {{ form_errors(registrationForm) }}

                    <div class="form-row">
                        <div class="form-group" id="firstNameGroup">
                            <label for="registration_form_firstName">Prénom</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user"></i>
                                {{ form_widget(registrationForm.firstName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Entrez votre prénom'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.firstName) }}
                        </div>

                        <div class="form-group" id="lastNameGroup">
                            <label for="registration_form_lastName">Nom</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user"></i>
                                {{ form_widget(registrationForm.lastName, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Entrez votre nom'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.lastName) }}
                        </div>
                    </div>

                    <div class="form-group" id="emailGroup">
                        <label for="registration_form_email">Adresse E-mail</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'form-control', 'placeholder': 'Entrez votre adresse mail'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form-group" id="phoneGroup">
                        <label for="registration_form_phone">Numéro de téléphone</label>
                        <div class="input-with-icon">
                            <i class="fas fa-phone"></i>
                            {{ form_widget(registrationForm.phone, {
                                'attr': {'class': 'form-control', 'placeholder': 'Entrez votre numéro de téléphone'}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.phone) }}
                    </div>

                    <div class="form-row">
                        <div class="form-group" id="passwordGroup">
                            <label for="registration_form_plainPassword_first">Mot de passe</label>
                            <div class="input-with-icon">
                                <i class="fas fa-lock"></i>
                                {{ form_widget(registrationForm.plainPassword.first, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Créez un mot de passe', 'autocomplete': 'new-password'}
                                }) }}
                            </div>
                        </div>

                        <div class="form-group" id="confirmPasswordGroup">
                            <label for="registration_form_plainPassword_second">Confirmer le mot de passe</label>
                            <div class="input-with-icon">
                                <i class="fas fa-lock"></i>
                                {{ form_widget(registrationForm.plainPassword.second, {
                                    'attr': {'class': 'form-control', 'placeholder': 'Confirmez votre mot de passe', 'autocomplete': 'new-password'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    </div>

                    <div class="form-group" id="levelGroup">
                        <label for="registration_form_skillLevel">Niveau de compétence (1-10)</label>
                        <div class="input-with-icon">
                            <i class="fas fa-chart-bar"></i>
                            {{ form_widget(registrationForm.skillLevel, {
                                'attr': {'class': 'form-control', 'placeholder': 'Entrez votre niveau (ex: 5.5)', 'min': 1, 'max': 10, 'step': 0.1}
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.skillLevel) }}
                        <div class="skill-level-hint">
                            <small>1 = Débutant, 10 = Professionnel (les décimales comme 3.5, 7.2 sont autorisées)</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" id="positionGroup">
                            <label for="registration_form_preferredPosition">Position préférée</label>
                            <div class="input-with-icon">
                                <i class="fas fa-arrows-alt-h"></i>
                                {{ form_widget(registrationForm.preferredPosition, {
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.preferredPosition) }}
                        </div>

                        <div class="form-group" id="handGroup">
                            <label for="registration_form_playingHand">Main de jeu</label>
                            <div class="input-with-icon">
                                <i class="fas fa-hand-paper"></i>
                                {{ form_widget(registrationForm.playingHand, {
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.playingHand) }}
                        </div>
                    </div>

                    <div class="form-checkbox">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        <label for="registration_form_agreeTerms">
                            J'accepte les
                            <a href="{{ path('app_terms') }}" target="_blank" class="legal-link">Conditions d'utilisation</a> et la
                            <a href="{{ path('app_privacy') }}" target="_blank" class="legal-link">Politique de confidentialité</a>
                        </label>
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <i class="fas fa-user-plus"></i> Créer mon compte
                    </button>

                    <div class="login-link">
                        Déjà inscrit ? <a href="{{ path('app_login') }}">Connectez-vous ici</a>
                    </div>

                {{ form_end(registrationForm) }}
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/sign_up.js') }}"></script>
{% endblock %}
