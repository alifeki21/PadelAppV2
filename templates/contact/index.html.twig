{% extends 'base.html.twig' %}

{% set active_page = 'contact' %}

{% block title %}Contact Us - Padel Badeli 7yeti{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/contact.css') }}">
    <style>
        .contact-form .form-group { margin-bottom: 1rem; }
        .contact-form label { display: block; font-weight: 500; margin-bottom: 0.4rem; color: #333; }
        .contact-form .form-control {
            width: 100%; padding: 0.65rem 0.85rem; border: 1px solid #d4d4d8;
            border-radius: 8px; background: #fafafa; font-size: 0.95rem; box-sizing: border-box;
        }
        .contact-form .form-control:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); background: #fff; }
        .row-2cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        @media (max-width: 600px) { .row-2cols { grid-template-columns: 1fr; } }
        .conditional-block { display: none; margin-top: 1rem; padding: 1.25rem; border-radius: 10px; }
        .conditional-block.visible { display: block; }
        .block-feedback { background: #f5f3ff; border-left: 4px solid #8b5cf6; }
        .block-level { background: linear-gradient(135deg, #fff5f5 0%, #ffe4e6 100%); border: 1px solid #fecaca; }
        .block-level h4 { color: #b91c1c; margin: 0 0 0.25rem 0; display: flex; align-items: center; gap: 0.5rem; }
        .block-level .warn-icon { color: #f59e0b; font-size: 1.25rem; }
        .block-level .block-sub { color: #71717a; font-size: 0.875rem; margin-bottom: 1rem; }
        .rating-group { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.5rem; }
        .rating-option { cursor: pointer; padding: 0.75rem 0.5rem; border: 2px solid #e4e4e7; border-radius: 12px; text-align: center; background: #fff; flex: 1; min-width: 90px; }
        .rating-option input[type=radio] { display: none; }
        .rating-option:hover { border-color: #a78bfa; }
        .rating-option.selected { border-color: #6366f1; background: #ede9fe; }
        .rating-icon { display: block; font-size: 2rem; line-height: 1; margin-bottom: 0.35rem; }
        .rating-text { display: block; font-size: 0.78rem; color: #555; font-weight: 500; }
        .levels-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .alert { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; }
        .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
        .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
        .alert-info { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }
        .submit-btn { margin-top: 1rem; padding: 0.8rem 1.5rem; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; border: none; border-radius: 10px; font-weight: 600; font-size: 1rem; cursor: pointer; width: 100%; }
    </style>
{% endblock %}

{% block body %}
<main class="contact-main">
    <div class="about-us">
        <div class="about-content">
            <h2>À propos de nous</h2>
            <p>Bienvenue chez Padel Badeli 7yeti, votre destination privilégiée pour le padel !</p>
        </div>
        <div class="about-image">
            <img src="{{ asset('images/padel_court.jpeg') }}" alt="Terrain de Padel">
        </div>
    </div>

    <div class="contact-wrapper">
        <div class="contact-container">
            <h1>Contactez-nous &amp; Feedback</h1>
            <p class="text-muted">Une question, un bug, une suggestion, un signalement ?</p>

            {% for label, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% if app.user %}
                {{ form_start(form, {attr: {class: 'contact-form', id: 'contact-form', novalidate: 'novalidate'}}) }}
                    <div class="row-2cols">
                        <div class="form-group">
                            {{ form_label(form.contactName) }}
                            {{ form_widget(form.contactName) }}
                            {{ form_errors(form.contactName) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.contactEmail) }}
                            {{ form_widget(form.contactEmail) }}
                            {{ form_errors(form.contactEmail) }}
                        </div>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.type) }}
                        {{ form_widget(form.type, {id: 'contact-type'}) }}
                        {{ form_errors(form.type) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.subject) }}
                        {{ form_widget(form.subject) }}
                        {{ form_errors(form.subject) }}
                    </div>
                    <div id="block-feedback" class="conditional-block block-feedback">
                        <label class="form-label">Évaluation globale (optionnel)</label>
                        <div class="rating-group">
                            {% set emojis = ['😞', '🙁', '😐', '🙂', '😄'] %}
                            {% set labels = ['Mauvais', 'Moyen', 'Correct', 'Bon', 'Excellent'] %}
                            {% for i in 1..5 %}
                                <label class="rating-option" data-value="{{ i }}">
                                    <input type="radio" name="{{ form.rating.vars.full_name }}" value="{{ i }}" {% if form.rating.vars.value == i %}checked{% endif %}>
                                    <span class="rating-icon">{{ emojis[i-1] }}</span>
                                    <span class="rating-text">{{ labels[i-1] }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.rating) }}
                        {% do form.rating.setRendered %}
                    </div>
                    <div id="block-level" class="conditional-block block-level">
                        <h4><span class="warn-icon">⚠️</span> Signaler un niveau erroné</h4>
                        <p class="block-sub">Sélectionnez le joueur concerné et indiquez le niveau correct.</p>
                        <div class="form-group">
                            {{ form_label(form.reportedUser) }}
                            {{ form_widget(form.reportedUser) }}
                            {{ form_errors(form.reportedUser) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.reportedPlayerName) }}
                            {{ form_widget(form.reportedPlayerName) }}
                            {{ form_errors(form.reportedPlayerName) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.reportedPlayerPhone) }}
                            {{ form_widget(form.reportedPlayerPhone) }}
                            {{ form_errors(form.reportedPlayerPhone) }}
                        </div>
                        <div class="levels-row">
                            <div class="form-group">
                                {{ form_label(form.reportedCurrentLevel) }}
                                {{ form_widget(form.reportedCurrentLevel) }}
                                {{ form_errors(form.reportedCurrentLevel) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.reportedSuggestedLevel) }}
                                {{ form_widget(form.reportedSuggestedLevel) }}
                                {{ form_errors(form.reportedSuggestedLevel) }}
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.message) }}
                        {{ form_widget(form.message) }}
                        {{ form_errors(form.message) }}
                    </div>
                    <button type="submit" class="submit-btn">Envoyer le message</button>
                {{ form_end(form) }}
                <script>
                console.log('[contact] script loaded');
                (function() {
                    function init() {
                        var typeSelect = document.getElementById('contact-type');
                        var blockFeedback = document.getElementById('block-feedback');
                        var blockLevel = document.getElementById('block-level');
                        console.log('[contact] typeSelect:', typeSelect);
                        console.log('[contact] blockFeedback:', blockFeedback);
                        console.log('[contact] blockLevel:', blockLevel);
                        if (!typeSelect) {
                            console.warn('[contact] contact-type select NOT FOUND - check form widget id');
                            return;
                        }
                        function updateBlocks() {
                            var v = typeSelect.value;
                            console.log('[contact] type changed to:', v);
                            if (blockFeedback) blockFeedback.classList.toggle('visible', v !== 'contact');
                            if (blockLevel) blockLevel.classList.toggle('visible', v === 'level');
                        }
                        typeSelect.addEventListener('change', updateBlocks);
                        updateBlocks();
                        var opts = document.querySelectorAll('.rating-option');
                        opts.forEach(function(o) {
                            var r = o.querySelector('input[type=radio]');
                            if (r && r.checked) o.classList.add('selected');
                            o.addEventListener('click', function() {
                                opts.forEach(function(x) { x.classList.remove('selected'); });
                                o.classList.add('selected');
                                if (r) r.checked = true;
                            });
                        });
                    }
                    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
                    else init();
                })();
                </script>
            {% else %}
                <div class="alert alert-info">
                    <p>Pour nous envoyer un message, merci de
                        <a href="{{ path('app_login') }}">vous connecter</a> ou
                        <a href="{{ path('app_signup') }}">créer un compte</a>.
                    </p>
                </div>
            {% endif %}
        </div>
        <div class="social-media-section">
            <h3>Suivez-nous</h3>
            <div class="social-icons">
                <a href="https://www.facebook.com/ali.feki.3762?locale=fr_FR" class="social-icon facebook" title="Facebook">f</a>
                <a href="#" class="social-icon twitter" title="Twitter">𝕏</a>
                <a href="https://www.instagram.com/insat.tunisie/" class="social-icon instagram" title="Instagram">@</a>
                <a href="#" class="social-icon linkedin" title="LinkedIn">in</a>
            </div>
        </div>
    </div>
</main>
{% endblock %}
