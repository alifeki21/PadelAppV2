{% extends 'base.html.twig' %}

{% set active_page = 'contact' %}

{% block title %}Contact Us - Padel Badeli 7yeti{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/contact.css') }}">
{% endblock %}

{% block body %}
    <main class="contact-main">
        <div class="about-us">
            <div class="about-content">
                <h2>À propos de nous</h2>
                <p>Bienvenue chez Padel Badeli 7yeti, votre destination privilégiée pour tout ce qui concerne le padel !
                    Nous sommes passionnés par ce sport et déterminés à offrir une expérience exceptionnelle aux joueurs
                    de tous niveaux. Que vous soyez un pro chevronné ou que vous débutiez, nos installations de pointe
                    et notre équipe de coachs experts sont là pour vous aider à améliorer votre jeu et à profiter des
                    sensations du padel. Rejoignez-nous dès aujourd'hui et faites partie de notre communauté dynamique
                    de passionnés de padel !</p>
                <div class="feedback-links-container">
                    <div class="feedback-link">
                        {# TODO: href="{{ path('app_feedback') }}" #}
                        <a href="#">Feedback positive</a>
                    </div>
                    <div class="feedback-link">
                        {# TODO: href="{{ path('app_report_level') }}" #}
                        <a href="#">Feedback negative</a>
                    </div>
                </div>
            </div>
            <div class="about-image">
                <img src="{{ asset('images/padel_court.jpeg') }}" alt="Terrain de Padel">
            </div>
        </div>
        <div class="contact-wrapper">
            <div class="contact-container">
                <h1>Contactez-nous</h1>
                {# TODO: add action="{{ path('app_contact_submit') }}" method="post" and CSRF token #}
                <form class="contact-form" action="" method="post">
                    <div class="form-group">
                        <label for="name">Nom</label>
                        <input type="text" id="name" name="name" required placeholder="Votre nom complet">
                    </div>
                    <div class="form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" required placeholder="votre@email.com">
                    </div>
                    <div class="form-group">
                        <label for="subject">Sujet</label>
                        <input type="text" id="subject" name="subject" required placeholder="Le sujet de votre message">
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="5" required placeholder="Votre message..."></textarea>
                    </div>
                    <button type="submit" class="submit-btn">Envoyer le message</button>
                </form>
            </div>
            <div class="social-media-section">
                <h3>Suivez-nous</h3>
                <div class="social-icons">
                    <a href="https://www.facebook.com/ali.feki.3762?locale=fr_FR" class="social-icon facebook" title="Facebook">f</a>
                    <a href="#" class="social-icon twitter" title="Twitter">𝕏</a>
                    <a href="https://www.instagram.com/insat.tunisie/" class="social-icon instagram" title="Instagram">@</a>
                    <a href="#" class="social-icon linkedin" title="LinkedIn">in</a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
